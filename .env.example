# Postgres connection string (Neon, Supabase, Vercel Postgres ...).
# DATABASE_URL, STORAGE_URL, POSTGRES_URL and NEON_DATABASE_URL are all accepted.
# When unset, the ranking API keeps scores in process memory (lost on restart).
DATABASE_URL=

# Comma-separated IPs allowed to open /editor and to see test-bed songs.
# Exact addresses, or prefixes ending with "." / ":" for a range. Unset = nobody in production.
# Find your current IP at /api/access on the deployed site.
EDITOR_ALLOWED_IPS=
